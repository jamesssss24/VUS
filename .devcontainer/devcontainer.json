{
  "name": "VUS",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Steam and GTK's glycin sandbox need namespace operations blocked by Docker's defaults.
  "runArgs": [
    "--shm-size=1g",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    // To enable a Linux host's integrated GPU, add:
    // "--device=/dev/dri",
    // "--group-add=video",
    // "--group-add=109"
  ],
  // To expose host-mounted storage, set VUS_STORAGE_PATH on the host and uncomment:
  // "mounts": [
  //   "source=${localEnv:VUS_STORAGE_PATH},target=/mnt/device-storage,type=bind"
  // ],
  "forwardPorts": [6080, 8080],
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "iPad File Transfer",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  }
}
